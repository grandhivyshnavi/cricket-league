# Supabase project credentials (Project Settings → API).
# When these are not set, the app runs in local DEMO MODE:
# data is stored in this browser only and a demo admin sign-in is available.
# Replace the empty values below with your actual project URL and anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Future: Razorpay public key id (never put the key secret in a VITE_ variable).
VITE_RAZORPAY_KEY_ID=

# Local testing only: set to "true" to bypass the registration-window gate on the
# frontend. The Supabase backend still enforces its own window unless you also
# adjust registration_opens/registration_closes in tournament_settings.
VITE_BYPASS_REGISTRATION_WINDOW=false
